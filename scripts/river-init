#!/usr/bin/env bash
set -euo pipefail

project_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
wm_binary=${MYWM_BINARY:-"$project_dir/target/debug/mywm"}
monitor_config=${MYWM_MONITOR_CONFIG:-"$project_dir/config/kanshi.conf"}
# Eine persönliche Konfiguration hat Vorrang vor dem Projektbeispiel.
user_config="${XDG_CONFIG_HOME:-$HOME/.config}/mywm/config.toml"
if [[ ! -v MYWM_CONFIG && ! -f $user_config ]]; then
    export MYWM_CONFIG="$project_dir/config/mywm.toml"
fi

if [[ -z ${WAYLAND_DISPLAY:-} ]]; then
    echo 'river-init muss innerhalb von River gestartet werden (river -c ...).' >&2
    exit 1
fi
if ! command -v kanshi >/dev/null 2>&1; then
    echo 'Kanshi fehlt. Installieren mit: sudo pacman -S --needed kanshi' >&2
    exit 1
fi
if [[ ! -x $wm_binary ]]; then
    echo "mywm fehlt oder ist nicht ausführbar: $wm_binary. Zuerst cargo build ausführen." >&2
    exit 1
fi
if [[ ! -r $monitor_config ]]; then
    echo "Monitorkonfiguration nicht lesbar: $monitor_config" >&2
    exit 1
fi

for dependency in swaylock swayidle wlopm; do
    if ! command -v "$dependency" >/dev/null 2>&1; then
        echo "Fehlende Sitzungskomponente: $dependency. Installieren: sudo pacman -S swaylock swayidle wlopm" >&2
        exit 1
    fi
done

# A private directory isolates IPC from other River sessions and stale sockets.
ipc_dir=$(mktemp -d "${XDG_RUNTIME_DIR:?}/mywm-session.XXXXXX")
export MYWM_SOCKET="$ipc_dir/control.sock"
children=()
cleanup() {
    trap - EXIT INT TERM
    if (( ${#children[@]} )); then
        kill "${children[@]}" 2>/dev/null || true
        wait "${children[@]}" 2>/dev/null || true
    fi
    rm -f -- "$MYWM_SOCKET"
    rmdir -- "$ipc_dir"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

kanshi -c "$monitor_config" &
children+=("$!")
"$wm_binary" &
children+=("$!")

"$wm_binary" --idle &
children+=("$!")
session_children=("${children[@]}")
# D-Bus activated dialogs need the compositor's display, not the login environment.
if ! "$project_dir/scripts/session-environment"; then
    echo 'Warnung: Portal-Umgebung konnte nicht vollständig eingerichtet werden.' >&2
fi
"$wm_binary" --wallpaper &
children+=("$!")
"$wm_binary" --bar &
children+=("$!")

# Beide Prozesse gehören zu dieser River-Sitzung. Beim Ende eines Prozesses
# wird auch der andere beendet, damit kein alter Kanshi-Prozess zurückbleibt.
status=0
wait -n "${session_children[@]}" || status=$?
echo "Ein Sitzungsprozess wurde beendet (Status $status); mywm/Kanshi/Idle werden gestoppt." >&2
exit "$status"
